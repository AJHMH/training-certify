{
  "name": "training-certify",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:api-coverage": "node scripts/check-api-coverage.mjs",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "node node_modules/typescript-native/bin/tsc --noEmit",
    "type-check:ts6": "node node_modules/typescript/bin/tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "prettier --write . && eslint --fix",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "db:backup": "bash scripts/backup-db.sh",
    "db:seed-vendors": "npx tsx scripts/run-seed-vendors-keep-list.ts",
    "catalog:fill-validation": "pnpm dlx tsx scripts/fill-vendor-validation-from-catalog.ts",
    "env:validate": "node --experimental-strip-types -e \"import { validateEnv } from './src/lib/env.ts'; validateEnv(); console.log('Environment OK')\"",
    "docs": "typedoc",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.5.12",
    "@sentry/tanstackstart-react": "^10.73.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.50",
    "@tanstack/router-plugin": "^1.168.36",
    "@vercel/blob": "^2.8.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.577.0",
    "nitro": "3.0.260429-beta",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "use-sync-external-store": "^1.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@clerk/testing": "^2.1.4",
    "@playwright/test": "^1.61.0",
    "@tanstack/devtools-vite": "^0.7.0",
    "@tanstack/eslint-config": "^0.4.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "dotenv": "^17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "prettier": "^3.8.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.0",
    "typescript-native": "npm:typescript@^7.0.0",
    "vercel": "^54.14.2",
    "vite": "^7.3.5",
    "vitest": "^4.1.9"
  }
}
